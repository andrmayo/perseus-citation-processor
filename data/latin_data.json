  "_which_pliny_function": "def _which_pliny(work: str) -> Optional[str]:\n    for pliny in (\"pliny_junior\", \"pliny_senior\"):\n        if LATIN_WORK_URNS[pliny].get(work):\n            return pliny\n    return",
